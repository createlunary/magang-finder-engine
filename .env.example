# Salin jadi .env lalu isi. File .env tidak ikut ke git.

# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram — token dari @BotFather, chat id dari `python mf.py telegram-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Jooble — https://jooble.org/api/about
JOOBLE_API_KEY=

# Adzuna — https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Careerjet — affiliate id dari https://www.careerjet.com/partners/
CAREERJET_AFFID=

# Login panel lokal lewat situs showcase (api/auth.py). Nilai rahasia HARUS sama dengan env Vercel.
# Buat dengan: python -c "import secrets;print(secrets.token_urlsafe(48))"
MF_JEMBATAN_SECRET=
# Email Google yang boleh membuka panel kontrol, pisahkan dengan koma. Kosong = hanya komputer ini.
MF_EMAIL_IZIN=
